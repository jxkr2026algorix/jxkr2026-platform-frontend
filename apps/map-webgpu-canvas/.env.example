# TMap (SK open API) — set this to use TMap tiles for the "map" basemap style.
# Without it the map style falls back to CARTO Voyager automatically.
# Put real values in .env.local (git-ignored) and restart `yarn dev:map`.
VITE_TMAP_APP_KEY=

# Optional: override the tile URL template. Placeholders: {z} {x} {y}
# ({y} = XYZ), {ytms} (= TMS, y flipped), {key}. Default goes through the
# dev-server proxy because TMap's tile hosts do not send CORS headers:
# VITE_TMAP_TILE_URL=/tmap-tiles/{z}/{x}/{ytms}.png?version=20220406
