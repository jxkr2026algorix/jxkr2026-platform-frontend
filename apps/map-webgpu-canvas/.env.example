# TMap tiles — enable the same-origin tile proxy for the "map" basemap style.
# When disabled or unavailable, the map falls back to CARTO Voyager.
VITE_TMAP_ENABLED=1

# Optional: override the tile URL template. Placeholders: {s} {z} {x} {y}
# ({y} = XYZ), {ytms} (= TMS, y flipped). Default goes through the
# dev-server proxy because TMap's tile hosts do not send CORS headers:
# VITE_TMAP_TILE_URL=/tmap-tiles{s}/{z}/{x}/{ytms}.png?version=20220406
