# Public TLS contact
ACME_EMAIL=ops@example.com

# Dashboard HTTP Basic authentication. Generate the hash with
# ./scripts/hash-dashboard-password.sh and keep the single quotes.
DASHBOARD_USERNAME=operator
DASHBOARD_PASSWORD_HASH='$2a$14$replace_with_generated_bcrypt_hash'

# Trusted server-to-server backend URL and audience-specific credentials.
SALGIL_PLATFORM_API_URL=https://platform-api.example.com
SALGIL_OPERATOR_API_KEY=replace_with_operator_key
SALGIL_MOBILE_API_KEY=replace_with_mobile_limited_key

# Browser-safe build settings only.
VITE_PLATFORM_REGION_CODE=47750
VITE_TMAP_ENABLED=1
