# 로컬 개발 환경. 이 파일을 `.env.local` 로 복사해 값을 채우세요.
#
#   cp .env.local.example .env.local
#
# `.env.local` 은 gitignore 되어 있습니다. 키를 커밋하지 마세요.
# 여기 값은 **개발 서버의 프록시**만 읽습니다 — 브라우저로 나가지 않습니다.
# 브라우저에 넣어야 하는 값은 VITE_ 로 시작합니다 (맨 아래).

# ── 어느 백엔드를 볼 것인가 ────────────────────────────────────────────────
# 실서버:
SALGIL_PLATFORM_API_URL=https://api.salgil.gyeongbuk.kr
# 내 컴퓨터에서 띄운 백엔드 (기본값):
# SALGIL_PLATFORM_API_URL=http://127.0.0.1:8000

# ── 키 ────────────────────────────────────────────────────────────────────
# 화면마다 다른 키를 씁니다. 모바일은 QR 로 아무나 들어오는 청중 화면이고,
# 그 화면에 상황을 발령할 수 있는 키를 심으면 관객 수만큼 복제됩니다.
SALGIL_OPERATOR_API_KEY=
SALGIL_MOBILE_API_KEY=
# 둘 다 비어 있을 때 쓸 공용 키. 로컬 백엔드라면 비워 두세요 — 개발 키로 떨어집니다.
SALGIL_PLATFORM_API_KEY=

# ── 브라우저로 나가는 값 ──────────────────────────────────────────────────
# 기본으로 볼 시군 (청송군 47750).
VITE_PLATFORM_REGION_CODE=47750
# TMap 위성 타일. 키가 없으면 위성 대신 일반 지도만 나옵니다.
VITE_TMAP_ENABLED=1
# VITE_TMAP_APP_KEY=
