{
  "files": {
    "includes": [
      "apps/**/*",
      "!apps/**/dist/**",
      "!apps/**/dev-dist/**",
      "!apps/map-webgpu-canvas/src/data/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
